*.raw
*.RAW
*.mzML
*.mzml
*.mgf
*.d/

# Pipeline output tables (templated names from the pipeline steps).
# NOTE: prepare/*.csv and salt/data/*.csv reference data are intentionally
# tracked and NOT ignored — check with `git check-ignore -v <path>` if unsure.
*_low_id_ms2_df*.csv
*_RSM_*.csv
*_Evalue_*.csv
manifest_decoy.csv
manifest_*report*.csv
